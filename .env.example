# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this key to the browser or a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Public origin of this deployment, without a trailing slash, e.g. https://backtosstv.org. Used to
# build the invite link, which carries BOOTSTRAP_TOKEN: taking the host from a request header would
# let a forged Host aim that link, token included, at another domain. On Vercel the deployment
# hostname is used when this is unset; locally the request host is the last resort.
SITE_URL=

# Shack admin bootstrap. Generate a long random value with `openssl rand -hex 32`. Hex matters:
# the token travels in a URL, and base64 output can contain a `+`, which a URL parser reads as a
# space, so the token stops matching and /shack/bootstrap answers 404.
# Needed while bootstrapping or inviting administrators; see the README.
BOOTSTRAP_TOKEN=

# Optional. The public API's request budget is always enforced; these only change where it is
# counted. Unset, the counters live in Postgres, through count_api_request(), which works from the
# first deployment, since the secret key above is all it needs.
#
# Setting a Redis takes over: one round trip of a few milliseconds instead of a write in front of
# the read it is protecting. Worth it once the traffic is. Upstash Redis and Vercel KV both work and
# both speak the same REST protocol, so either pair of names does:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   KV_REST_API_URL / KV_REST_API_TOKEN
# Either way the limiter fails open: a store that is down or slow lets requests through rather than
# taking the API with it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests per minute per caller. Defaults to 120.
RATE_LIMIT_PER_MINUTE=

# Optional, server-only. A READ-ONLY UptimeRobot API key, which /status reads to show the uptime
# history. Create it under Integrations & API; the main key can pause and delete monitors and has no
# business here. Unset, /status still reports whether the catalogue is answering and says that no
# monitor is configured. The free plan allows ten API requests per minute for the whole account,
# which is why the page is rebuilt on a timer rather than per visitor.
UPTIMEROBOT_API_KEY=

# TLE database (server-only). A separate Supabase project holds satellite TLEs. Read by the server
# and never sent to the browser, so these are NOT NEXT_PUBLIC_ variables.
TLE_SUPABASE_URL=
TLE_SUPABASE_KEY=
